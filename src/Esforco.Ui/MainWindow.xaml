<Window x:Class="Esforco.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Esforco.Ui"
        Title="Esforço"
        Height="720"
        Width="1040"
        MinHeight="480"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4EF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1C1B19"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="BotaoRegistro" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NaPaginaDeRegistro}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoEscritorios" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NaPaginaDeRelatorio}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoCalendario" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NaPaginaDeCalendario}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoVistaDiaria" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhVistaDiaria}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoVistaSemanal" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhVistaSemanal}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoVistaMensal" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhVistaMensal}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoModoEscritorios" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhModoEscritorios}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoModoProgramas" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhModoProgramas}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoModoTelas" TargetType="Button" BasedOn="{StaticResource BotaoAba}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhModoTelas}" Value="True">
                    <Setter Property="Background" Value="#1F3D32"/>
                    <Setter Property="Foreground" Value="#F7F6F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotaoDia" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecipienteDoBloco" TargetType="ContentPresenter">
            <Setter Property="local:TrilhaDeHorario.InicioMinuto" Value="{Binding InicioMinuto}"/>
            <Setter Property="local:TrilhaDeHorario.FimMinuto" Value="{Binding FimMinuto}"/>
            <Setter Property="local:TrilhaDeHorario.InicioSegundo" Value="{Binding InicioSegundo}"/>
            <Setter Property="local:TrilhaDeHorario.FimSegundo" Value="{Binding FimSegundo}"/>
            <Setter Property="local:TrilhaDeHorario.Trilha" Value="{Binding Trilha}"/>
            <Setter Property="local:TrilhaDeHorario.Manual" Value="{Binding EhManual}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <DataTemplate x:Key="ConteudoDoBalao">
            <StackPanel MaxWidth="280">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,4"
                            Visibility="{Binding TemTipo, Converter={StaticResource BoleanoParaVisibilidade}}">
                    <TextBlock Text="{Binding Simbolo}"
                               FontFamily="{StaticResource FonteDeIcones}"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Subtitulo}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Horario}" Foreground="#7A756C" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding DicaDoClique}"
                           Foreground="#7A756C"
                           FontSize="11"
                           Margin="0,4,0,0"
                           Visibility="{Binding Clicavel, Converter={StaticResource BoleanoParaVisibilidade}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- O registro manual tem a cor do escritório, com listras por cima: é o que o separa do que o Esforço leu sozinho. -->
        <DrawingBrush x:Key="Hachura"
                      TileMode="Tile"
                      Viewport="0,0,8,8"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,8,8"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,8 L8,0 M-2,2 L2,-2 M6,10 L10,6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#47FFFFFF" Thickness="2"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DataTemplate x:Key="BlocoDoCalendario">
            <Border Background="{Binding Fundo}"
                    BorderBrush="#F4F1EA"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Border.ToolTip>
                    <ToolTip Content="{Binding}"
                             ContentTemplate="{StaticResource ConteudoDoBalao}"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"/>
                </Border.ToolTip>
                <Grid>
                <Rectangle Fill="{StaticResource Hachura}"
                           RadiusX="3"
                           RadiusY="3"
                           Visibility="{Binding EhManual, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                <Rectangle Stroke="#F7F6F2"
                           StrokeThickness="1.5"
                           StrokeDashArray="3 2"
                           RadiusX="3"
                           RadiusY="3"
                           Visibility="{Binding EhManual, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                <StackPanel VerticalAlignment="Top" Margin="5,2,4,2">
                    <TextBlock Text="{Binding Titulo}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#F7F6F2"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding TemTipo, Converter={StaticResource BoleanoParaVisibilidade}}">
                        <TextBlock Text="{Binding Simbolo}"
                                   FontFamily="{StaticResource FonteDeIcones}"
                                   FontSize="12"
                                   Foreground="#F7F6F2"
                                   Margin="0,1,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Tipo}"
                                   FontSize="11"
                                   Foreground="#F7F6F2"
                                   Opacity="0.92"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitulo}"
                               FontSize="11"
                               Foreground="#F7F6F2"
                               Opacity="0.9"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Horario}"
                               FontSize="11"
                               Foreground="#F7F6F2"
                               Opacity="0.78"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="FaixaCompacta">
            <Border Background="{Binding Fundo}"
                    CornerRadius="2"
                    Height="6"
                    ClipToBounds="True">
                <Border.ToolTip>
                    <ToolTip Content="{Binding}"
                             ContentTemplate="{StaticResource ConteudoDoBalao}"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"/>
                </Border.ToolTip>
                <Rectangle Fill="{StaticResource Hachura}"
                           Visibility="{Binding EhManual, Converter={StaticResource BoleanoParaVisibilidade}}"/>
            </Border>
        </DataTemplate>
        <Style x:Key="BotaoEditarLinha" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1F3D32"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;"
                                           Style="{StaticResource Icone}"
                                           FontSize="11"
                                           Margin="0,0,5,0"/>
                                <TextBlock x:Name="Texto" Text="editar"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PontoDeSituacao" TargetType="Ellipse">
            <Setter Property="Fill" Value="#B5AFA3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EmLeitura}" Value="True">
                    <Setter Property="Fill" Value="#2E8B62"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Legenda" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A847A"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TextoDoIntervalo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A756C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DuranteReuniao}" Value="True">
                    <Setter Property="Foreground" Value="#2F5D7C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="LinhaDoIntervalo">
            <Grid Margin="0,1,8,1" ToolTip="{Binding Dica}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Inicio}" Style="{StaticResource TextoDoIntervalo}"/>
                <TextBlock Grid.Column="1" Text="{Binding Fim}" Style="{StaticResource TextoDoIntervalo}"/>
                <TextBlock Grid.Column="2" Text="{Binding Duracao}" Style="{StaticResource TextoDoIntervalo}"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding Escritorio}"
                           Style="{StaticResource TextoDoIntervalo}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding Janela}" Style="{StaticResource TextoDoIntervalo}"/>
                <Button Grid.Column="4"
                        Command="{Binding Editar}"
                        Style="{StaticResource BotaoEditarLinha}"
                        ToolTip="Alterar ou excluir este registro manual"
                        Visibility="{Binding Manual, Converter={StaticResource BoleanoParaVisibilidade}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NoDaArvore">
            <StackPanel Margin="0,0,0,2">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="⋯"
                            Style="{StaticResource BotaoMenu}"
                            ToolTip="Ações deste programa"
                            Click="AbrirMenu"
                            Visibility="{Binding EhPrograma, Converter={StaticResource BoleanoParaVisibilidade}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding TextoPausa}" Command="{Binding Pausar}"/>
                                <MenuItem Header="{Binding TextoFixar}" Command="{Binding Fixar}"/>
                                <MenuItem Header="{Binding TextoOcultar}" Command="{Binding Ocultar}"/>
                                <Separator/>
                                <MenuItem Header="Excluir" Command="{Binding Excluir}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Command="{Binding Alternar}"
                            Style="{StaticResource BotaoNo}"
                            ToolTip="{Binding Dica}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding DuracaoTotal}"
                                       Foreground="#7A756C"
                                       Margin="12,0,4,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Marcas}"
                                       Margin="8,0,0,0"
                                       Foreground="#8A847A"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding TemMarcas, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Seta}"
                                       Style="{StaticResource Icone}"
                                       FontSize="10"
                                       Width="18"
                                       Foreground="#7A756C"/>
                            <TextBlock Text="{Binding Rotulo}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Rotulo}"/>
                        </DockPanel>
                    </Button>
                </DockPanel>
                <StackPanel Margin="18,0,0,0"
                            Visibility="{Binding ConteudoVisivel, Converter={StaticResource BoleanoParaVisibilidade}}">
                    <Grid Margin="22,6,8,2"
                          Visibility="{Binding TemIntervalos, Converter={StaticResource BoleanoParaVisibilidade}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="124"/>
                            <ColumnDefinition Width="124"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Início" Style="{StaticResource Legenda}"/>
                        <TextBlock Grid.Column="1" Text="Fim" Style="{StaticResource Legenda}"/>
                        <TextBlock Grid.Column="2" Text="Duração" Style="{StaticResource Legenda}"/>
                        <TextBlock Grid.Column="3" Text="Escritório" Style="{StaticResource Legenda}"/>
                        <TextBlock Grid.Column="4" Text="Janela" Style="{StaticResource Legenda}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Intervalos}"
                                  ItemTemplate="{StaticResource LinhaDoIntervalo}"
                                  Margin="22,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Filhos}"
                                  ItemTemplate="{DynamicResource NoDaArvore}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DiaDoRegistro">
            <Border Style="{StaticResource Cartao}" Padding="8,6,4,4" Margin="0,0,8,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NoDaArvore}"/>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="20,16,20,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding NaPaginaDeRegistro, Converter={StaticResource BoleanoParaVisibilidade}}">
                    <Button Content="{Binding TextoOcultos}"
                            Command="{Binding AlternarOcultos}"
                            Style="{StaticResource BotaoSecundario}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Visibility="{Binding TemOcultos, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                    <Button Content="Recolher tudo"
                            Command="{Binding RecolherTudo}"
                            Style="{StaticResource BotaoSecundario}"
                            Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Abrir tudo"
                            Command="{Binding AbrirTudo}"
                            Style="{StaticResource BotaoSecundario}"
                            Padding="12,6"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#EBE7DE"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding VerRegistro}"
                                    Style="{StaticResource BotaoRegistro}"
                                    Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                    <TextBlock Text="Registro"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding VerCalendario}"
                                    Style="{StaticResource BotaoCalendario}"
                                    Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE162;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                    <TextBlock Text="Calendário"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding VerEscritorios}"
                                    Style="{StaticResource BotaoEscritorios}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE821;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                    <TextBlock Text="Escritórios"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding Iniciar}"
                            Style="{StaticResource BotaoPrimario}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Iniciar"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Parar}"
                            Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Parar"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ZerarPeriodo}"
                            Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Zerar período"/>
                        </StackPanel>
                    </Button>
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,1,7,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource PontoDeSituacao}"/>
                    <TextBlock Text="{Binding Situacao}"
                               VerticalAlignment="Center"
                               Foreground="#7A756C"/>
                </StackPanel>
            </DockPanel>
            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource BotaoSecundario}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Click="AbrirMenu"
                        ToolTip="{Binding TextoDoAtalho}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Vínculos salvos…" Command="{Binding AbrirVinculos}"/>
                            <MenuItem Header="Categorias…" Command="{Binding AbrirCategorias}"/>
                            <Separator/>
                            <MenuItem Header="{Binding RotuloDoAtalho}" Command="{Binding AbrirAtalho}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                        <TextBlock Text="Vínculos"/>
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icone}" FontSize="10" Margin="8,1,0,0"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource BotaoSecundario}"
                        Padding="12,6"
                        Click="AbrirMenu"
                        ToolTip="Filtro de datas">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Hoje"
                                      IsCheckable="True"
                                      IsChecked="{Binding EhFiltroHoje, Mode=OneWay}"
                                      Command="{Binding IrParaHoje}"/>
                            <MenuItem Header="Semanal"
                                      IsCheckable="True"
                                      IsChecked="{Binding EhFiltroSemanal, Mode=OneWay}"
                                      Command="{Binding UsarFiltroSemanal}"/>
                            <MenuItem Header="De domingo a sábado"
                                      IsCheckable="True"
                                      StaysOpenOnClick="True"
                                      IsChecked="{Binding IncluirFimDeSemana, Mode=TwoWay}"
                                      ToolTip="A semana passa a ir de domingo a sábado"/>
                            <Separator/>
                            <MenuItem Header="Mensal"
                                      IsCheckable="True"
                                      IsChecked="{Binding EhFiltroMensal, Mode=OneWay}"
                                      Command="{Binding UsarFiltroMensal}"/>
                            <MenuItem Header="Trimestral"
                                      IsCheckable="True"
                                      IsChecked="{Binding EhFiltroTrimestral, Mode=OneWay}"
                                      Command="{Binding UsarFiltroTrimestral}"/>
                            <MenuItem Header="Semestral"
                                      IsCheckable="True"
                                      IsChecked="{Binding EhFiltroSemestral, Mode=OneWay}"
                                      Command="{Binding UsarFiltroSemestral}"/>
                            <MenuItem Header="Anual"
                                      IsCheckable="True"
                                      IsChecked="{Binding EhFiltroAnual, Mode=OneWay}"
                                      Command="{Binding UsarFiltroAnual}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding RotuloDoFiltro}"/>
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icone}" FontSize="10" Margin="8,1,0,0"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right"
                        Command="{Binding DiaSeguinte}"
                        Style="{StaticResource BotaoSecundario}"
                        Padding="10,8"
                        Margin="0,0,8,0"
                        ToolTip="Próximo período">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icone}" FontSize="10"/>
                </Button>
                <Button DockPanel.Dock="Left"
                        Command="{Binding DiaAnterior}"
                        Style="{StaticResource BotaoSecundario}"
                        Padding="10,8"
                        Margin="0,0,8,0"
                        ToolTip="Período anterior">
                    <TextBlock Text="&#xE76B;" Style="{StaticResource Icone}" FontSize="10"/>
                </Button>
                <DatePicker SelectedDate="{Binding DiaInicial, UpdateSourceTrigger=PropertyChanged}"
                            Width="130"
                            Margin="0,0,8,0"
                            SelectedDateFormat="Short"
                            Language="pt-BR"
                            VerticalAlignment="Center"/>
                <TextBlock Text="até"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#7A756C"/>
                <DatePicker SelectedDate="{Binding DiaFinal, UpdateSourceTrigger=PropertyChanged}"
                            Width="130"
                            SelectedDateFormat="Short"
                            Language="pt-BR"
                            VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding TextoDoAtalho}"
                       Foreground="#8A3B32"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding AtalhoRecusado, Converter={StaticResource BoleanoParaVisibilidade}}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,10,0,0"
                   Style="{StaticResource Legenda}"
                   TextWrapping="Wrap"
                   Text="O botão … de cada programa oculta, fixa, exclui o tempo gravado ou pausa a coleta."
                   Visibility="{Binding NaPaginaDeRegistro, Converter={StaticResource BoleanoParaVisibilidade}}"/>
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,10,0,0"
                   Style="{StaticResource Legenda}"
                   TextWrapping="Wrap"
                   Text="{Binding LegendaDoCalendario}"
                   Visibility="{Binding NaPaginaDeCalendario, Converter={StaticResource BoleanoParaVisibilidade}}"/>

        <Grid>
            <TextBlock Text="{Binding TextoVazio}"
                       Foreground="#7A756C"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Visibility="{Binding MostrarVazioDoRegistro, Converter={StaticResource BoleanoParaVisibilidade}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding MostrarRegistro, Converter={StaticResource BoleanoParaVisibilidade}}">
                <ItemsControl ItemsSource="{Binding Nos}"
                              ItemTemplate="{StaticResource DiaDoRegistro}"/>
            </ScrollViewer>

            <DockPanel Visibility="{Binding NaPaginaDeCalendario, Converter={StaticResource BoleanoParaVisibilidade}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right"
                            Background="#EBE7DE"
                            CornerRadius="8"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Escritórios"
                                    Command="{Binding UsarModoEscritorios}"
                                    Style="{StaticResource BotaoModoEscritorios}"
                                    Margin="0,0,2,0"/>
                            <Button Content="Programas"
                                    Command="{Binding UsarModoProgramas}"
                                    Style="{StaticResource BotaoModoProgramas}"
                                    Margin="0,0,2,0"/>
                            <Button Content="Telas"
                                    Command="{Binding UsarModoTelas}"
                                    Style="{StaticResource BotaoModoTelas}"/>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Left"
                            Command="{Binding NovoRegistroManual}"
                            Style="{StaticResource BotaoPrimario}"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Lança à mão um tempo para um escritório. Também dá para clicar ou arrastar numa área vazia do dia.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Novo registro"/>
                        </StackPanel>
                    </Button>
                    <Border Background="#EBE7DE"
                            CornerRadius="8"
                            Padding="3"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Diário"
                                    Command="{Binding UsarVistaDiaria}"
                                    Style="{StaticResource BotaoVistaDiaria}"
                                    Margin="0,0,2,0"/>
                            <Button Content="Semanal"
                                    Command="{Binding UsarVistaSemanal}"
                                    Style="{StaticResource BotaoVistaSemanal}"
                                    Margin="0,0,2,0"/>
                            <Button Content="Mensal"
                                    Command="{Binding UsarVistaMensal}"
                                    Style="{StaticResource BotaoVistaMensal}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding TextoDoCalendario}"
                           Foreground="#7A756C"
                           Margin="0,0,0,8"
                           Visibility="{Binding TemAvisoDoCalendario, Converter={StaticResource BoleanoParaVisibilidade}}"/>

                <Grid>
                <Grid Visibility="{Binding MostrarLinhas, Converter={StaticResource BoleanoParaVisibilidade}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="EspacoDaBarra" Width="17"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DiasDoCalendario}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Abrir}"
                                            Style="{StaticResource BotaoDia}"
                                            HorizontalAlignment="Stretch"
                                            Margin="2,0,2,0"
                                            ToolTip="Abrir este dia">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Rotulo}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1C1B19"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                                <Setter Property="Foreground" Value="#1F3D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Duracao}"
                                                       FontSize="12"
                                                       Foreground="#7A756C"
                                                       HorizontalAlignment="Center"
                                                       MinHeight="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemFaixa}" Value="False">
                                                                <Setter Property="Opacity" Value="0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ScrollViewer x:Name="RolagemDoCalendario"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="RolagemDoCalendario_ScrollChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:TrilhaDeHorario Grid.Column="0"
                                                    Vertical="True"
                                                    DiaInteiro="True"
                                                    HoraInicial="0"
                                                    HoraFinal="24"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding DiasDoCalendario}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E6E1D6" BorderThickness="1,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FCFBF8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                            <Setter Property="Background" Value="#F3F7F4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding Blocos}"
                                                          ItemTemplate="{StaticResource BlocoDoCalendario}"
                                                          ItemContainerStyle="{StaticResource RecipienteDoBloco}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:TrilhaDeHorario Vertical="True"
                                                                                DiaInteiro="True"
                                                                                Rotulos="False"
                                                                                HoraInicial="0"
                                                                                HoraFinal="24"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding MostrarGrade, Converter={StaticResource BoleanoParaVisibilidade}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding CabecalhosDoCalendario}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               Foreground="#8A847A"
                                               Margin="8,0,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding DiasDoCalendario}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Abrir}"
                                            Style="{StaticResource BotaoDia}"
                                            Margin="3"
                                            Opacity="{Binding Opacidade}">
                                        <Border Background="#FCFBF8"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,6"
                                                MinHeight="108">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#E1DCD1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1F3D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding Duracao}"
                                                               FontSize="10"
                                                               Foreground="#8A847A"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding TemFaixa, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                    <TextBlock Text="{Binding Numero}" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Blocos}"
                                                              ItemTemplate="{StaticResource FaixaCompacta}"
                                                              ItemContainerStyle="{StaticResource RecipienteDoBloco}"
                                                              Margin="0,0,0,4">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <local:TrilhaDeHorario Compacto="True"
                                                                                    HoraInicial="{Binding DataContext.HoraInicial, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    HoraFinal="{Binding DataContext.HoraFinal, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Linhas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2,0,0" ToolTip="{Binding Titulo}">
                                                                <Border DockPanel.Dock="Left"
                                                                        Width="8"
                                                                        Height="8"
                                                                        CornerRadius="2"
                                                                        Background="{Binding Fundo}"
                                                                        Margin="0,3,6,0"/>
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding Duracao}"
                                                                           FontSize="10"
                                                                           Foreground="#8A847A"
                                                                           Margin="4,0,0,0"/>
                                                                <TextBlock Text="{Binding Titulo}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>

            <DockPanel Visibility="{Binding NaPaginaDeRelatorio, Converter={StaticResource BoleanoParaVisibilidade}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AbrirOcultos}"
                                Style="{StaticResource BotaoSecundario}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                ToolTip="Esconde do relatório escritórios pelo nome ou pelo id">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                <TextBlock Text="Ocultar escritórios"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopiarTransferencia}"
                                Style="{StaticResource BotaoSecundario}"
                                Padding="12,6"
                                ToolTip="Copia o código, o percentual e o nome, prontos para colar no Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Copiar para transferência"/>
                        </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Escritórios" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,2,12,0"
                                   Foreground="#7A756C"
                                   TextWrapping="Wrap">
                            <Run Text="Painel, Chatwoot, reuniões e outros trabalhos ficam em colunas separadas. Outros trabalhos é o tempo que você ligou ao escritório por um vínculo manual ou lançou num registro manual. "/>
                            <Run Text="Em azul" Foreground="#2F5D7C"/>
                            <Run Text=" é o painel, o Chatwoot ou o trabalho vinculado feito durante a reunião do mesmo escritório, e o registro manual no horário que outro registro do mesmo escritório já conta: não entra no total. A parte é a fatia desse total: painel contado, Chatwoot contado, reuniões e outros trabalhos contados."/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="Nenhum tempo na SplitC neste período."
                           Foreground="#7A756C"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="{Binding MostrarVazioDoRelatorio, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding MostrarRelatorio, Converter={StaticResource BoleanoParaVisibilidade}}">
                    <StackPanel Margin="0,0,8,0">
                        <Grid Margin="15,0,13,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Escritório" Style="{StaticResource Legenda}" Margin="18,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Painel" Style="{StaticResource Legenda}"/>
                            <TextBlock Grid.Column="2" Text="Chatwoot" Style="{StaticResource Legenda}"/>
                            <TextBlock Grid.Column="3" Text="Reuniões" Style="{StaticResource Legenda}"/>
                            <TextBlock Grid.Column="4" Text="Outros trabalhos" Style="{StaticResource Legenda}" ToolTip="Tempo ligado a este escritório por vínculo manual, fora da reunião dele, e tempo lançado em registro manual."/>
                            <TextBlock Grid.Column="5" Text="Total" Style="{StaticResource Legenda}" ToolTip="Painel contado, Chatwoot contado, reuniões e outros trabalhos. O azul não entra."/>
                            <TextBlock Grid.Column="6" Text="Parte" Style="{StaticResource Legenda}" ToolTip="Fatia desse total."/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Escritorios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Cartao}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding Alternar}"
                                                        Style="{StaticResource BotaoNo}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="56"/>
                                                        </Grid.ColumnDefinitions>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Seta}"
                                                                       Style="{StaticResource Icone}"
                                                                       FontSize="10"
                                                                       Width="18"
                                                                       Foreground="#7A756C"/>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Rotulo}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Rotulo}"
                                                                       VerticalAlignment="Center"/>
                                                            <Border DockPanel.Dock="Left"
                                                                    Style="{StaticResource Etiqueta}"
                                                                    Margin="8,1,0,0"
                                                                    Visibility="{Binding TemEtiqueta, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                                <TextBlock Text="{Binding Etiqueta}"
                                                                           FontSize="11"
                                                                           Foreground="#6E695F"/>
                                                            </Border>
                                                        </DockPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DuracaoPainel}"/>
                                                            <TextBlock Text="{Binding DuracaoPainelNaReuniao}"
                                                                       Foreground="#2F5D7C"
                                                                       FontSize="12"
                                                                       ToolTip="No painel durante a reunião. Aparece aqui e não entra no total."
                                                                       Visibility="{Binding TemPainelNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DuracaoChat}"
                                                                       ToolTip="Tempo no Chatwoot deste escritório, fora da reunião."/>
                                                            <TextBlock Text="{Binding DuracaoChatNaReuniao}"
                                                                       Foreground="#2F5D7C"
                                                                       FontSize="12"
                                                                       ToolTip="No Chatwoot durante a reunião. Aparece aqui e não entra no total."
                                                                       Visibility="{Binding TemChatNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding DuracaoReunioes}"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DuracaoOutros}"
                                                                       ToolTip="Tempo ligado a este escritório por vínculo manual, fora da reunião dele, e tempo lançado em registro manual."/>
                                                            <TextBlock Text="{Binding DuracaoOutrosNaReuniao}"
                                                                       Foreground="#2F5D7C"
                                                                       FontSize="12"
                                                                       ToolTip="Trabalho vinculado durante a reunião, ou registro manual num horário que outro registro deste escritório já conta. Aparece aqui e não entra no total."
                                                                       Visibility="{Binding TemOutrosNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding DuracaoTotal}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Painel contado, Chatwoot contado, reuniões e outros trabalhos. O azul não entra."/>
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding Parte}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Fatia do total."/>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Content="⋯"
                                                        Style="{StaticResource BotaoMenu}"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Editar este escritório"
                                                        Click="AbrirMenu"
                                                        Visibility="{Binding Editavel, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Editar nome" Command="{Binding EditarNome}"/>
                                                            <MenuItem Header="Variações do nome" Command="{Binding EditarVariacoes}"/>
                                                            <MenuItem Header="Nomes dos planos" Command="{Binding EditarPlanos}"/>
                                                            <Separator Visibility="{Binding Editando, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                            <MenuItem Header="Fechar edição"
                                                                      Command="{Binding FecharEdicao}"
                                                                      Visibility="{Binding Editando, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                            <StackPanel Margin="20,6,0,3"
                                                        Visibility="{Binding ConteudoVisivel, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                <TextBlock Text="{Binding TextoLivre}"
                                                           Foreground="#7A756C"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6"
                                                           Visibility="{Binding MostrarTextoLivre, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                <DockPanel Margin="0,0,0,4"
                                                           Visibility="{Binding MostrarVariacoes, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="&#xE8AC;"
                                                               Style="{StaticResource Icone}"
                                                               VerticalAlignment="Top"
                                                               Margin="0,3,8,0"
                                                               Foreground="#8A847A"/>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="Variações:" Foreground="#8A847A"/>
                                                        <Run Text="{Binding TextoVariacoes, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,4"
                                                           Visibility="{Binding MostrarPlanos, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="&#xE8EC;"
                                                               Style="{StaticResource Icone}"
                                                               VerticalAlignment="Top"
                                                               Margin="0,3,8,0"
                                                               Foreground="#8A847A"/>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="Planos:" Foreground="#8A847A"/>
                                                        <Run Text="{Binding TextoPlanos, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <Border Background="#FFFFFF"
                                                        BorderBrush="#E1DCD1"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,9"
                                                        Margin="0,2,0,6"
                                                        Visibility="{Binding EditandoNome, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="&#xE711;"
                                                                    FontFamily="{StaticResource FonteDeIcones}"
                                                                    FontSize="10"
                                                                    Command="{Binding FecharEdicao}"
                                                                    Style="{StaticResource BotaoMenu}"
                                                                    ToolTip="Fechar"/>
                                                            <TextBlock Text="Nome do escritório"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="Salvar"
                                                                    Command="{Binding SalvarNome}"
                                                                    Style="{StaticResource BotaoPrimario}"
                                                                    Padding="14,6"
                                                                    Margin="8,0,0,0"/>
                                                            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource Campo}"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FFFFFF"
                                                        BorderBrush="#E1DCD1"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,9"
                                                        Margin="0,2,0,6"
                                                        Visibility="{Binding EditandoVariacoes, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,2">
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="&#xE711;"
                                                                    FontFamily="{StaticResource FonteDeIcones}"
                                                                    FontSize="10"
                                                                    Command="{Binding FecharEdicao}"
                                                                    Style="{StaticResource BotaoMenu}"
                                                                    ToolTip="Fechar"/>
                                                            <TextBlock Text="Variações do nome"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <TextBlock Text="Liga a este escritório as reuniões em que o nome aparece escrito de outro jeito."
                                                                   Foreground="#7A756C"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,6"/>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="Adicionar"
                                                                    Command="{Binding AdicionarVariacao}"
                                                                    Style="{StaticResource BotaoPrimario}"
                                                                    Padding="14,6"
                                                                    Margin="8,0,0,0"/>
                                                            <TextBox Text="{Binding NovaVariacao, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource Campo}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Aviso}"
                                                                   Foreground="#8A3B32"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding TemAviso, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        <ItemsControl ItemsSource="{Binding Variacoes}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource Etiqueta}"
                                                                            Padding="8,2,2,2"
                                                                            Margin="0,4,6,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Texto}" VerticalAlignment="Center"/>
                                                                            <Button Content="&#xE711;"
                                                                                    FontFamily="{StaticResource FonteDeIcones}"
                                                                                    FontSize="8"
                                                                                    Width="20"
                                                                                    Height="20"
                                                                                    Margin="4,0,0,0"
                                                                                    Command="{Binding Remover}"
                                                                                    Style="{StaticResource BotaoMenu}"
                                                                                    ToolTip="Tirar esta variação"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FFFFFF"
                                                        BorderBrush="#E1DCD1"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,9"
                                                        Margin="0,2,0,6"
                                                        Visibility="{Binding EditandoPlanos, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,2">
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="&#xE711;"
                                                                    FontFamily="{StaticResource FonteDeIcones}"
                                                                    FontSize="10"
                                                                    Command="{Binding FecharEdicao}"
                                                                    Style="{StaticResource BotaoMenu}"
                                                                    ToolTip="Fechar"/>
                                                            <TextBlock Text="Nomes dos planos"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <TextBlock Text="Nenhum plano neste escritório ainda."
                                                                   Foreground="#7A756C"
                                                                   Visibility="{Binding SemPlanos, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        <ItemsControl ItemsSource="{Binding Planos}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,6,0,0">
                                                                        <Button DockPanel.Dock="Right"
                                                                                Content="Salvar"
                                                                                Command="{Binding Salvar}"
                                                                                Style="{StaticResource BotaoSecundario}"
                                                                                Padding="14,6"
                                                                                Margin="8,0,0,0"/>
                                                                        <TextBlock DockPanel.Dock="Left"
                                                                                   Text="{Binding Rotulo}"
                                                                                   Width="96"
                                                                                   Foreground="#7A756C"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Rotulo}"/>
                                                                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Style="{StaticResource Campo}"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Secao}" Margin="0,2,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Reuniões"
                                                                   Style="{StaticResource Legenda}"
                                                                   Margin="0,0,0,3"/>
                                                        <TextBlock Text="Nenhuma reunião neste período."
                                                                   Foreground="#7A756C"
                                                                   Visibility="{Binding SemReunioes, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                        <ItemsControl ItemsSource="{Binding Temas}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <DockPanel Margin="0,2,0,0"
                                                                                   Visibility="{Binding VariosDias, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                                            <TextBlock DockPanel.Dock="Right"
                                                                                       Text="{Binding Duracao}"
                                                                                       FontWeight="SemiBold"
                                                                                       Margin="12,0,0,0"/>
                                                                            <TextBlock Text="{Binding Tema}"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </DockPanel>
                                                                        <ItemsControl ItemsSource="{Binding Dias}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Margin="0,2,0,2">
                                                                                        <DockPanel>
                                                                                            <TextBlock DockPanel.Dock="Right"
                                                                                                       Text="{Binding Duracao}"
                                                                                                       Margin="12,0,0,0"/>
                                                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                                                <Run Text="{Binding Titulo, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding FaixaUnica, Mode=OneWay}" Foreground="#7A756C"/>
                                                                                            </TextBlock>
                                                                                        </DockPanel>
                                                                                        <ItemsControl ItemsSource="{Binding Ocorrencias}"
                                                                                                      Margin="12,2,0,0"
                                                                                                      Visibility="{Binding Varias, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <DockPanel Margin="0,1,0,0">
                                                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                                                   Text="{Binding Duracao}"
                                                                                                                   Foreground="#7A756C"
                                                                                                                   Margin="12,0,0,0"/>
                                                                                                        <TextBlock Text="{Binding Faixa}" Foreground="#7A756C"/>
                                                                                                    </DockPanel>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Secao}"
                                                        Margin="0,8,0,0"
                                                        Visibility="{Binding MostrarOutros, Converter={StaticResource BoleanoParaVisibilidade}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Outros trabalhos"
                                                                   Style="{StaticResource Legenda}"
                                                                   Margin="0,0,0,3"/>
                                                        <ItemsControl ItemsSource="{Binding Outros}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,2,0,2">
                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                   Text="{Binding Duracao}"
                                                                                   Margin="12,0,0,0"
                                                                                   ToolTip="Fora da reunião do escritório. Entra no total."/>
                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                   Text="{Binding DuracaoNaReuniao}"
                                                                                   Foreground="#2F5D7C"
                                                                                   Margin="12,0,0,0"
                                                                                   ToolTip="Durante a reunião do escritório. Não entra no total."
                                                                                   Visibility="{Binding TemNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                                                        <TextBlock Text="{Binding Categoria}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Cartao}"
                                Background="#EFEBE3"
                                Margin="0,2,0,2">
                            <Grid Margin="2,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total"
                                           FontWeight="SemiBold"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalDoRelatorio}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalPainelNaReuniao}"
                                               Foreground="#2F5D7C"
                                               FontSize="12"
                                               ToolTip="No painel durante a reunião. Não entra neste total."
                                               Visibility="{Binding TemPainelNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalChat}"
                                               FontWeight="SemiBold"
                                               ToolTip="Tempo no Chatwoot, fora da reunião."/>
                                    <TextBlock Text="{Binding TotalChatNaReuniao}"
                                               Foreground="#2F5D7C"
                                               FontSize="12"
                                               ToolTip="No Chatwoot durante a reunião. Não entra neste total."
                                               Visibility="{Binding TemChatNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalDeReunioes}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalOutros}"
                                               FontWeight="SemiBold"
                                               ToolTip="Tempo ligado a escritórios por vínculo manual, fora da reunião, e tempo lançado em registro manual."/>
                                    <TextBlock Text="{Binding TotalOutrosNaReuniao}"
                                               Foreground="#2F5D7C"
                                               FontSize="12"
                                               ToolTip="Trabalho vinculado durante a reunião, ou registro manual num horário que outro registro do escritório já conta. Não entra neste total."
                                               Visibility="{Binding TemOutrosNaReuniao, Converter={StaticResource BoleanoParaVisibilidade}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="5"
                                           Text="{Binding TotalGeral}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           ToolTip="Painel contado, Chatwoot contado, reuniões e outros trabalhos. O azul não entra."/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
