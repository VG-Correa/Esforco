<Window x:Class="Esforco.Ui.JanelaDeVinculo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escritório e contagem da janela"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F6F4EF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1C1B19"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="AoTeclar">
    <Window.Resources>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- O escritório marcado fica com a mesma cor forte mesmo quando o cursor está em outro campo. -->
        <Style x:Key="EscritorioDaLista" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="#1C1B19"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fundo"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#F1EEE7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#1F3D32"/>
                                <Setter Property="Foreground" Value="#F7F6F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <StackPanel x:Name="PainelParado" Visibility="Collapsed" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Text="O Esforço está parado e, parado, não lê a janela da frente. Clique em Iniciar na janela do Esforço e use o atalho de novo."/>
            <Button Content="Fechar"
                    Click="Cancelar"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BotaoSecundario}"
                    Padding="14,6"/>
        </StackPanel>

        <!-- Os botões ficam presos embaixo e os campos rolam: em tela baixa a janelinha não passa da tela. -->
        <DockPanel x:Name="PainelDoVinculo">
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="Aviso"
                           TextWrapping="Wrap"
                           Foreground="#8A3B32"
                           Margin="0,8,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Click="Cancelar"
                            Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BotaoSalvar"
                            Content="Salvar"
                            IsDefault="True"
                            Click="Confirmar"
                            Style="{StaticResource BotaoPrimario}"/>
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
            <StackPanel>
            <Border Style="{StaticResource Secao}">
                <StackPanel>
                    <TextBlock x:Name="Cabecalho"
                               Text="O que está sendo registrado"
                               Foreground="#8A847A"
                               FontSize="12"
                               Margin="0,0,0,3"/>
                    <TextBlock x:Name="TextoPrograma"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TextoTitulo"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="36"/>
                    <TextBlock x:Name="TextoEndereco"
                               Foreground="#7A756C"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TextoPeriodo"
                               Foreground="#7A756C"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="AvisoDescoberto"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Foreground="#2F5D7C"
                       Margin="0,8,0,0"
                       Text="O Esforço já descobriu sozinho o escritório deste registro (painel, Chatwoot ou reunião) e isso continua valendo. O vínculo só entra onde não houver escritório descoberto."/>
            <DockPanel x:Name="PainelDaSituacao"
                       Visibility="Collapsed"
                       Margin="0,8,0,0">
                <Button x:Name="BotaoOutroVinculo"
                        DockPanel.Dock="Right"
                        Content="Criar outro vínculo"
                        Click="CriarOutro"
                        Style="{StaticResource BotaoSecundario}"
                        Padding="10,4"
                        FontSize="12"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Deixa o vínculo salvo como está e abre os campos em branco para um vínculo novo"/>
                <TextBlock x:Name="Situacao"
                           TextWrapping="Wrap"
                           Foreground="#1F3D32"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- A contagem é uma configuração da janela: é salva mesmo sem escolher escritório. -->
            <StackPanel x:Name="PainelDaContagem">
                <TextBlock Text="Contagem do tempo" Style="{StaticResource Rotulo}"/>
                <RadioButton x:Name="ContagemEmFoco"
                             GroupName="Contagem"
                             IsChecked="True"
                             Content="Só quando está em foco"/>
                <RadioButton x:Name="ContagemAberta"
                             GroupName="Contagem"
                             Content="Enquanto estiver aberta, mesmo sem foco ou minimizada"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="Vale para"
                               Foreground="#7A756C"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <RadioButton x:Name="ContagemPelaJanela"
                                 DockPanel.Dock="Left"
                                 GroupName="AlcanceDaContagem"
                                 IsChecked="True"
                                 Checked="AoTrocarAlcanceDaContagem"
                                 Content="esta janela"
                                 Margin="0,0,14,0"/>
                    <RadioButton x:Name="ContagemPeloPrograma"
                                 GroupName="AlcanceDaContagem"
                                 Checked="AoTrocarAlcanceDaContagem"
                                 Margin="0">
                        <TextBlock x:Name="TextoDoProgramaDaContagem"
                                   Text="o programa inteiro"
                                   TextTrimming="CharacterEllipsis"/>
                    </RadioButton>
                </DockPanel>
                <TextBlock x:Name="SituacaoDaContagem"
                           Foreground="#7A756C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Text="Escritório" Style="{StaticResource Rotulo}"/>
            <TextBox x:Name="Busca"
                     Style="{StaticResource Campo}"
                     TextChanged="AoBuscar"
                     PreviewKeyDown="AoTeclarNaBusca"
                     ToolTip="Escreva um pedaço do nome ou do id"/>
            <ListBox x:Name="ListaDeEscritorios"
                     Height="100"
                     Margin="0,4,0,0"
                     Background="#FFFFFF"
                     BorderBrush="#D5D0C6"
                     DisplayMemberPath="Rotulo"
                     SelectionChanged="AoEscolherEscritorio"
                     ItemContainerStyle="{StaticResource EscritorioDaLista}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock x:Name="SemEscritorios"
                       Visibility="Collapsed"
                       Foreground="#7A756C"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

            <TextBlock Text="Categoria (opcional)" Style="{StaticResource Rotulo}"/>
            <ComboBox x:Name="CampoCategoria"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      Padding="6,4"
                      ToolTip="Escolha uma categoria da sua lista ou escreva uma nova"/>

            <TextBlock Text="Alcance do escritório" Style="{StaticResource Rotulo}"/>
            <RadioButton x:Name="AlcancePrograma" GroupName="Alcance" Content="O programa inteiro"/>
            <RadioButton x:Name="AlcanceJanela" GroupName="Alcance" Content="Esta janela ou arquivo, pelo título"/>
            <RadioButton x:Name="AlcanceAba" GroupName="Alcance" Content="Esta aba, pelo título ou pelo endereço" Margin="0"/>

            <StackPanel x:Name="PainelDoRegistro" Visibility="Collapsed">
                <TextBlock Text="Vale para" Style="{StaticResource Rotulo}"/>
                <RadioButton x:Name="SoRegistro"
                             GroupName="Aplicacao"
                             IsChecked="True"
                             Checked="AoMudarOpcao"
                             Content="Só este registro"/>
                <RadioButton x:Name="SempreRegistro"
                             GroupName="Aplicacao"
                             Checked="AoMudarOpcao"
                             Content="Sempre este programa, janela ou aba"
                             Margin="0"/>
            </StackPanel>

            <StackPanel x:Name="PainelDaValidade">
                <TextBlock Text="Validade" Style="{StaticResource Rotulo}"/>
                <RadioButton x:Name="ValidadeSempre"
                             GroupName="Validade"
                             IsChecked="True"
                             Checked="AoMudarOpcao"
                             Content="Sempre"/>
                <RadioButton x:Name="ValidadePrazo"
                             GroupName="Validade"
                             Checked="AoMudarOpcao"
                             Content="Por um prazo fixo"/>
                <RadioButton x:Name="ValidadeInatividade"
                             GroupName="Validade"
                             Checked="AoMudarOpcao"
                             Content="Até ficar um tempo sem voltar"
                             Margin="0"/>
                <StackPanel x:Name="PainelDoPrazo" Margin="22,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="A partir de"
                                   Width="96"
                                   VerticalAlignment="Center"
                                   Foreground="#7A756C"/>
                        <DatePicker x:Name="DiaDoInicio"
                                    Width="130"
                                    SelectedDateFormat="Short"
                                    Language="pt-BR"
                                    VerticalAlignment="Center"/>
                        <TextBox x:Name="HoraDoInicio"
                                 Width="78"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource Campo}"
                                 ToolTip="Hora e minuto, como 14:30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RotuloDoTempo"
                                   Text="Por"
                                   Width="96"
                                   VerticalAlignment="Center"
                                   Foreground="#7A756C"/>
                        <ComboBox x:Name="Tempo"
                                  Width="90"
                                  Padding="6,4"
                                  SelectedIndex="0"
                                  SelectionChanged="AoMudarTempo">
                            <ComboBoxItem Content="30 min"/>
                            <ComboBoxItem Content="1 h"/>
                            <ComboBoxItem Content="Outro"/>
                        </ComboBox>
                        <TextBox x:Name="OutroTempo"
                                 Width="56"
                                 Margin="8,0,0,0"
                                 Style="{StaticResource Campo}"
                                 Visibility="Collapsed"/>
                        <ComboBox x:Name="UnidadeDoTempo"
                                  Width="72"
                                  Margin="8,0,0,0"
                                  Padding="6,4"
                                  SelectedIndex="0"
                                  Visibility="Collapsed">
                            <ComboBoxItem Content="min"/>
                            <ComboBoxItem Content="horas"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
