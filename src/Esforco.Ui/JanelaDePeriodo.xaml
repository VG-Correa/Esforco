<Window x:Class="Esforco.Ui.JanelaDePeriodo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zerar período"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F6F4EF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1C1B19"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Text="Apaga o tempo gravado nesse intervalo, em todos os programas e nos registros manuais. O que ficou fora dele permanece."/>

        <RadioButton x:Name="OpcaoHoje"
                     Content="Hoje"
                     GroupName="Periodo"
                     IsChecked="True"
                     Margin="0,0,0,8"/>
        <RadioButton x:Name="OpcaoOntem"
                     Content="Ontem"
                     GroupName="Periodo"
                     Margin="0,0,0,8"/>
        <RadioButton x:Name="OpcaoSemana"
                     Content="Esta semana"
                     GroupName="Periodo"
                     Margin="0,0,0,8"/>
        <RadioButton x:Name="OpcaoDatas"
                     Content="Datas"
                     GroupName="Periodo"
                     Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Margin="22,0,0,8">
            <DatePicker x:Name="DiaInicial"
                        Width="140"
                        Margin="0,0,8,0"
                        SelectedDateFormat="Short"
                        IsEnabled="{Binding IsChecked, ElementName=OpcaoDatas}"/>
            <TextBlock Text="até"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="#7A756C"/>
            <DatePicker x:Name="DiaFinal"
                        Width="140"
                        SelectedDateFormat="Short"
                        IsEnabled="{Binding IsChecked, ElementName=OpcaoDatas}"/>
        </StackPanel>

        <TextBlock x:Name="Aviso"
                   TextWrapping="Wrap"
                   Foreground="#8A3B32"
                   Margin="22,0,0,16"
                   MinHeight="18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    IsCancel="True"
                    Style="{StaticResource BotaoSecundario}"
                    Margin="0,0,8,0"/>
            <Button Content="Zerar"
                    IsDefault="True"
                    Click="Confirmar"
                    Style="{StaticResource BotaoPrimario}"/>
        </StackPanel>
    </StackPanel>
</Window>
