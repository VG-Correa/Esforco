<Window x:Class="Esforco.Ui.JanelaDeAtalho"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atalho de vínculo"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F6F4EF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1C1B19"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Com o Esforço aberto, este atalho abre a janelinha de vínculo para a janela que estiver na frente. Ele só funciona enquanto o Esforço está aberto."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="UsarCtrl" Content="Ctrl" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="UsarAlt" Content="Alt" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="UsarShift" Content="Shift" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="UsarWin" Content="Win" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Tecla"
                       VerticalAlignment="Center"
                       Foreground="#7A756C"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="Tecla" Width="90" Padding="6,4"/>
        </StackPanel>

        <TextBlock x:Name="Situacao"
                   TextWrapping="Wrap"
                   Foreground="#7A756C"
                   Margin="0,4,0,0"/>
        <TextBlock x:Name="Aviso"
                   TextWrapping="Wrap"
                   Foreground="#8A3B32"
                   Margin="0,6,0,10"
                   MinHeight="18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Usar o padrão"
                    Click="UsarPadrao"
                    Style="{StaticResource BotaoSecundario}"
                    Margin="0,0,8,0"/>
            <Button Content="Fechar"
                    IsCancel="True"
                    Style="{StaticResource BotaoSecundario}"
                    Margin="0,0,8,0"/>
            <Button Content="Salvar"
                    IsDefault="True"
                    Click="Salvar"
                    Style="{StaticResource BotaoPrimario}"/>
        </StackPanel>
    </StackPanel>
</Window>
