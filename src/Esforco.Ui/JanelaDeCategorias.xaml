<Window x:Class="Esforco.Ui.JanelaDeCategorias"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categorias"
        Width="480"
        SizeToContent="Height"
        MaxHeight="680"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F6F4EF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1C1B19"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="A categoria diz que tipo de trabalho foi feito num vínculo ou num registro manual, como Suporte ou Implantação. No relatório de Escritórios, Outros trabalhos aparece agrupado por ela."/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Content="Criar"
                    Click="Criar"
                    Style="{StaticResource BotaoPrimario}"
                    Padding="14,6"
                    Margin="8,0,0,0"/>
            <TextBox x:Name="Nova"
                     Style="{StaticResource Campo}"
                     KeyDown="AoTeclarNaNova"
                     ToolTip="Nome da categoria nova"/>
        </DockPanel>

        <TextBlock x:Name="Aviso"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Foreground="#8A3B32"
                   Margin="0,0,0,10"
                   MinHeight="18"/>

        <Button DockPanel.Dock="Bottom"
                Content="Fechar"
                IsCancel="True"
                HorizontalAlignment="Right"
                Style="{StaticResource BotaoSecundario}"
                Padding="14,6"
                Margin="0,16,0,0"/>

        <Border x:Name="PainelDaExclusao"
                DockPanel.Dock="Bottom"
                Style="{StaticResource Secao}"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TextoDaExclusao"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <StackPanel x:Name="LinhaDaTroca" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="OpcaoTrocar"
                                 GroupName="Exclusao"
                                 Content="Trocar por"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center"/>
                    <ComboBox x:Name="Substituta"
                              Width="220"
                              Margin="8,0,0,0"
                              Padding="6,4"
                              DisplayMemberPath="Nome"
                              SelectionChanged="AoEscolherSubstituta"/>
                </StackPanel>
                <RadioButton x:Name="OpcaoRetirar"
                             GroupName="Exclusao"
                             Content="Tirar a categoria desses vínculos"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Não excluir"
                            Click="DesistirDaExclusao"
                            Style="{StaticResource BotaoSecundario}"
                            Padding="12,5"
                            Margin="0,0,8,0"/>
                    <Button Content="Excluir categoria"
                            Click="ConfirmarExclusao"
                            Style="{StaticResource BotaoPrimario}"
                            Padding="12,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <TextBlock x:Name="Vazio"
                       Text="Nenhuma categoria ainda."
                       Foreground="#7A756C"
                       VerticalAlignment="Top"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="300">
                <ItemsControl x:Name="Lista">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="excluir"
                                        Tag="{Binding}"
                                        Click="Excluir"
                                        Style="{StaticResource BotaoSecundario}"
                                        Padding="10,3"
                                        Margin="6,0,0,0"/>
                                <Button DockPanel.Dock="Right"
                                        Content="renomear"
                                        Tag="{Binding}"
                                        Click="Renomear"
                                        Style="{StaticResource BotaoSecundario}"
                                        Padding="10,3"
                                        Margin="8,0,0,0"
                                        ToolTip="Grava o nome escrito ao lado"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Uso}"
                                           Foreground="#7A756C"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Campo}"
                                         Padding="6,3"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
