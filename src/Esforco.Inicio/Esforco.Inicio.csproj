<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publicar para a raiz com o SDK, em modo autocontido e arquivo único, e copiar Esforco.exe para a raiz do repositório. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Esforco</AssemblyName>
    <RootNamespace>Esforco.Inicio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Esforço</Product>
    <AssemblyTitle>Esforço</AssemblyTitle>
    <Description>Confere o Windows e o .NET 10 e abre o Esforço.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
